#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

run_step() {
  local label="$1"
  shift
  local started_at=$SECONDS

  printf '\n==> %s\n' "$label"
  "$@"
  printf '<== %s (%ss)\n' "$label" "$((SECONDS - started_at))"
}

install_system_packages() {
  local packages=()

  command -v curl >/dev/null || packages+=(curl)

  if ((${#packages[@]} == 0)); then
    echo "System packages are already installed."
    return
  fi

  sudo apt-get update
  sudo apt-get install -y "${packages[@]}"
}

remove_legacy_development_tools() {
  local profile_marker="# rwx mise tools"

  if ! grep -Fqx "$profile_marker" "$HOME/.bash_profile" 2>/dev/null; then
    echo "Legacy orb development tools are already absent."
    return
  fi

  sed -i '/^# rwx mise tools$/,+1d' "$HOME/.bash_profile"
  rm -f "$HOME/.local/bin/mise"
  rm -rf "$HOME/.local/share/mise" "$HOME/.cache/mise" "$HOME/.local/state/mise"
}

install_latest_rwx() (
  local temp_dir
  temp_dir="$(mktemp -d)"
  trap 'rm -rf "$temp_dir"' EXIT

  curl -fsSL \
    https://github.com/rwx-cloud/rwx/releases/download/latest/rwx-linux-x86_64 \
    -o "$temp_dir/rwx"
  sudo install -m 0755 "$temp_dir/rwx" /usr/local/bin/rwx
  /usr/local/bin/rwx --version
)

run_step "Install required system packages" install_system_packages
run_step "Remove legacy orb development tools" remove_legacy_development_tools
run_step "Install the latest RWX CLI from GitHub" install_latest_rwx
