#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

run_step() {
  local label="$1"
  shift
  local started_at=$SECONDS

  printf '\n==> %s\n' "$label"
  "$@"
  printf '<== %s (%ss)\n' "$label" "$((SECONDS - started_at))"
}

install_system_packages() {
  local packages=()

  command -v curl >/dev/null || packages+=(curl)
  command -v git >/dev/null || packages+=(git)
  command -v git-lfs >/dev/null || packages+=(git-lfs)
  command -v make >/dev/null || packages+=(make)
  command -v tar >/dev/null || packages+=(tar)
  command -v unzip >/dev/null || packages+=(unzip)
  command -v xz >/dev/null || packages+=(xz-utils)

  if ((${#packages[@]} == 0)); then
    echo "System packages are already installed."
    return
  fi

  sudo apt-get update
  sudo apt-get install -y "${packages[@]}"
}

install_mise() {
  if [[ -x "$HOME/.local/bin/mise" ]]; then
    echo "mise is already installed."
    return
  fi

  curl -fsSL https://mise.run | sh
}

install_latest_rwx() (
  local temp_dir
  temp_dir="$(mktemp -d)"
  trap 'rm -rf "$temp_dir"' EXIT

  curl -fsSL \
    https://github.com/rwx-cloud/rwx/releases/download/latest/rwx-linux-x86_64 \
    -o "$temp_dir/rwx"
  sudo install -m 0755 "$temp_dir/rwx" /usr/local/bin/rwx
  /usr/local/bin/rwx --version
)

configure_login_shell() {
  local profile_marker="# rwx mise tools"

  touch "$HOME/.bash_profile"
  if grep -Fqx "$profile_marker" "$HOME/.bash_profile"; then
    echo "Login shell is already configured for mise."
    return
  fi

  cat >> "$HOME/.bash_profile" <<'EOF'

# rwx mise tools
export PATH="$HOME/.local/bin:$HOME/.local/share/mise/shims:$PATH"
EOF
}

configure_git() {
  git config --global init.defaultBranch main
  git lfs install --skip-repo
}

run_step "Install required system packages" install_system_packages
run_step "Install the latest RWX CLI from GitHub" install_latest_rwx
run_step "Install mise" install_mise
run_step "Configure mise for login shells" configure_login_shell

export PATH="$HOME/.local/bin:$HOME/.local/share/mise/shims:$PATH"

run_step "Install pinned development tools" mise install --yes
run_step "Download Go dependencies" mise exec -- go mod download
run_step "Configure Git" configure_git
run_step "Build the CLI and embedded language server" mise exec -- make build
